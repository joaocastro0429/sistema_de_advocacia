// generator e datasource configurados corretamente
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id            String    @id @default(uuid())
  name          String
  cpf           String?   @unique
  cnpj          String?   @unique
  dateOfBirth   DateTime?
  maritalStatus String?
  profession    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  appointments  Appointment[]
  
  // Pluralize o nome da relação para clareza: um cliente tem vários processos
  processes     Process[]

  @@map("clients")
}

model Process {
  id            String   @id @default(uuid())
  processNumber String   @unique
  court         String
  type          String
  status        String   @default("open")
  
  // Relacionamento com Lawyer
  lawyerId      String?
  lawyer        Lawyer?   @relation(fields: [lawyerId], references: [id])
  
  // Relacionamento com Client
  clientId    String?
  client        Client?   @relation(fields: [clientId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointment  Appointment[]


  @@map("processes") // Mudei para plural para manter o padrão
}

model Lawyer {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  oabNumber     String    @unique
  specialty     String
  phone         String?
  
  // Um advogado tem vários processos
  processes     Process[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  appointment Appointment[]


  @@map("lawyers")
}


model Appointment {
  id          String   @id @default(uuid())
  
  title       String   // Ex: "Reunião inicial", "Audiência", "Retorno"
  description String?  // Observações
  
  date        DateTime // Data e hora do agendamento
  
  status      AppointmentStatus @default(SCHEDULED)

  // 🔗 Relação com Cliente
  clientId    String?
  client      Client ?  @relation(fields: [clientId], references: [id])

  // 🔗 Relação com Advogado
  lawyerId    String?
  lawyer      Lawyer?   @relation(fields: [lawyerId], references: [id])

  // 🔗 (Opcional) Pode estar ligado a um processo
  processId   String?
  process     Process? @relation(fields: [processId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("appointments")
}

enum AppointmentStatus {
  SCHEDULED   // agendado
  COMPLETED   // realizado
  CANCELED    // cancelado
  NO_SHOW     // cliente não compareceu
}

